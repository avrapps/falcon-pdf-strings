    <!-- Welcome Slide 1 -->
    <string name="welcome_slide1_title">&lt;b&gt;எந்த ஆவணத்தையும்&lt;/b&gt; உடனடியாகப் படிக்கவும்</string>
    <string name="welcome_slide1_description">PDF, DOC, EPUB, MOBI உள்ளிட்ட 10க்கும் மேற்பட்ட ஆவண வடிவங்களைத் திறந்து நிர்வகிக்கவும்.</string>
    <string name="welcome_slide1_feature1">&lt;b&gt;PDFகள், மின்புத்தகங்கள்,&lt;/b&gt; மற்றும் அலுவலக ஆவணங்களை ஒரே இடத்தில் படிக்கவும்</string>
    <string name="welcome_slide1_feature2">&lt;b&gt;ஆவணங்களை&lt;/b&gt; பிடித்தமானவையாகவும், பல்வேறு சாதனங்களிலும் அவற்றை அணுகவும்.</string>
    <string name="welcome_slide1_feature3">&lt;b&gt;கருத்துரையிடவும்,&lt;/b&gt; சிறப்பித்துக் காட்டவும், மற்றும் எளிதாக இணைந்து செயல்படவும்.</string>
    <string name="welcome_slide1_footer">உங்கள் உலகளாவிய ஆவண வாசிப்பான்</string>
    <!-- Welcome Slide 2 -->
    <string name="welcome_slide2_title">&lt;b&gt;PDF கோப்புகளைத் திருத்தவும், ஸ்கேன் செய்யவும் மற்றும் ஒழுங்கமைக்கவும்&lt;/b&gt;</string>
    <string name="welcome_slide2_description">PDF கோப்புகளை உருவாக்க, திருத்த மற்றும் நிர்வகிக்கத் தேவையான அனைத்தும் ஒரே சக்திவாய்ந்த கருவித்தொகுப்பில் உள்ளன.</string>
    <string name="welcome_slide2_feature1">&lt;b&gt;உரையைத் திருத்தவும்,&lt;/b&gt; குறிப்புகளைச் சேர்க்கவும், ஹைலைட் செய்யவும், மற்றும் படிவங்களை நிரப்பவும்.</string>
    <string name="welcome_slide2_feature2">&lt;b&gt;ஆவணங்களை ஸ்கேன்&lt;/b&gt; செய்து அவற்றை உடனடியாக PDFகளாக மாற்றவும்</string>
    <string name="welcome_slide2_feature3">&lt;b&gt;ஒன்றிணைத்தல், மாற்றுதல், சுருக்குதல் மற்றும் பாதுகாத்தல் உள்ளிட்ட 30க்கும் மேற்பட்ட கருவிகள்&lt;/b&gt;</string>
    <string name="welcome_slide2_footer">உங்களுக்கான முழுமையான PDF பணிச்சூழல்</string>
    <!-- Welcome Slide 3 -->
    <string name="welcome_slide3_title">&lt;b&gt;உங்கள் ஆவணங்களை&lt;/b&gt; புரிந்துகொள்ளும் செயற்கை நுண்ணறிவு</string>
    <string name="welcome_slide3_description">உங்களுக்காக ஆவணங்களைப் படித்துப் பகுப்பாய்வு செய்யும் செயற்கை நுண்ணறிவு மூலம் பல மணிநேரங்களைச் சேமிக்கவும்.</string>
